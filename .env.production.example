# -----------------------------------------------------------------------------
# Production .env template — cPanel / shared hosting
#
# HOW TO USE THIS FILE
# --------------------
# The project you upload already contains a working .env (with a valid APP_KEY).
# The safest thing to do is OPEN THAT FILE and change only the lines marked
# "CHANGE ME" below.
#
# This template exists so you can see exactly what a production .env looks like.
# If you do paste it over the existing file you MUST copy the APP_KEY line from
# the old file first — without it every session, signed URL and encrypted value
# stops working.
#
# APP_KEY is never regenerated on the server; it travels with the project.
# -----------------------------------------------------------------------------

APP_NAME="Update Architects & Engineering"

# CHANGE ME — production environment. APP_ENV=production is also what switches
# on the CSP / HSTS / security-header middleware (it is disabled while debug is
# on, so leaving this at "local" removes those headers).
APP_ENV=production

# CHANGE ME — never true in production. With APP_DEBUG=false Laravel renders the
# friendly error page instead of a stack trace with paths and env values.
APP_DEBUG=false

# CHANGE ME — the exact public URL, https, no trailing slash, no /public suffix.
# Canonical URLs, the sitemap, og:image, JSON-LD and every media URL are built
# from this value, so a mistake here shows up in Google and in social previews.
APP_URL=https://example.com

# KEEP — the base64: key that shipped with the project. Do not regenerate it.
APP_KEY=base64:REPLACE_WITH_THE_KEY_FROM_THE_UPLOADED_DOTENV

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# CHANGE ME — "warn" keeps production logs useful without debug noise.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warn

# CHANGE ME — values come from cPanel > MySQL Databases. DB_HOST is usually
# localhost or 127.0.0.1 on shared hosting. Import database/architech.sql into
# this database through phpMyAdmin before the first visit.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_database_name
DB_USERNAME=CHANGE_ME_database_user
DB_PASSWORD=CHANGE_ME_database_password

# Database-backed session/cache/queue need no extra services, which is what
# makes this deployable on ordinary shared hosting. Leave all three as they are.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CHANGE ME — cPanel > Email Accounts gives you SMTP credentials for the domain.
# Enquiry and consultation notifications will not send until this is a real
# mailbox. Port 465 = SSL, port 587 = STARTTLS.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=CHANGE_ME_mailbox_password
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
